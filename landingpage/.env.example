# FUN MOMENT Landing Page & Support Service Environment Configuration
# Copy this file to .env for local testing or enter these variables in the Coolify UI.
# NEVER commit real passwords or .env files to version control.

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=funmomentsproject@gmail.com
# SECRET: Gmail App Password (16-character token from myaccount.google.com/apppasswords)
SMTP_PASS=

# Email Recipient for Inbound Support Inquiries
SUPPORT_TO_EMAIL=funmomentsproject@gmail.com

# Server & Application Runtime
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://funmoments.unifinitylab.com
