# FUN MOMENT Landing Page & Support Service Environment Configuration
# Copy this file to .env for local testing or configure in the Coolify UI.
# NEVER commit real access keys or .env files to version control.

# Web3Forms Form Access Key (Client-visible build-time variable for Vite)
# NOTE: In Coolify, mark this variable as available at BUILD TIME so Vite embeds it.
# Web3Forms access keys are public identifiers for browser forms, not passwords.
VITE_WEB3FORMS_ACCESS_KEY=

# Server & Application Runtime
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://funmoments.unifinitylab.com
