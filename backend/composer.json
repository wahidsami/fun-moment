{
    "name": "funmoment/funmoment",
    "type": "project",
    "description": "FunMoment Service Marketplace.",
    "keywords": [
        "funmoment",
        "marketplace"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "barryvdh/laravel-dompdf": "^v3.0.0",
        "brian2694/laravel-toastr": "^5.56",
        "doctrine/dbal": "3.6.4",
        "guzzlehttp/guzzle": "^7.0.1",
        "guzzlehttp/psr7": "^2.5",
        "intervention/image": "^2.5",
        "kkomelin/laravel-translatable-string-exporter": "^1.11",
        "laravel/framework": "^10.10",
        "laravel/sanctum": "^3.2",
        "laravel/socialite": "^5.2",
        "laravel/tinker": "^2.0",
        "livewire/livewire": "^2.12",
        "matanyadaev/laravel-eloquent-spatial": "^4.2.1",
        "mews/purifier": "^3.3",
        "nwidart/laravel-modules": "^8.3",
        "php-http/message": "^1.16",
        "php-http/message-factory": "^1.1",
        "pusher/pusher-php-server": "^7.0.6",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-sitemap": "^6.3",
        "stevebauman/location": "^7.3.2",
        "twilio/sdk": "^7.4",
        "xgenious/installer": "^1.0.7",
        "xgenious-fundorex/paymentgateway": "^2.0",
        "xgenious/xgapiclient": "^3.0",
        "yajra/laravel-datatables-oracle": "~10.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/cinetpay/cinetpay-php",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/xgenious-paymentgateway",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "packages/jomweb/billplz-laravel",
            "options": {
                "symlink": false
            }
        }
    ],
    "require-dev": {
        "spatie/laravel-ignition": "2.0",
        "laravel/ui": "^4.0",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/Helpers/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
